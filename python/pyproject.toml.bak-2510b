[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "deus-witness"
version = "0.2.30"
description = "Deus Witness: MCP proxy, Claude Code hook and SDK that put every agent tool call through an independent witness"
readme = "README.md"
requires-python = ">=3.10"
dependencies = ["mcp>=1.2,<2", "httpx>=0.27", "cbor2>=5.6", "cryptography>=42"]

[project.optional-dependencies]
verify = ["asn1crypto>=1.5", "opentimestamps>=0.4"]   # only for RFC 3161 tokens and the online Bitcoin anchor check

[project.urls]
Homepage = "https://witness.sipkigroup.com"
Documentation = "https://witness.sipkigroup.com/dl/docs/quickstart.html"
Source = "https://github.com/sipkigroup/witness"

[project.scripts]
deus-witness-mcp = "deus_witness.proxy:main"
deus-witness = "deus_witness.doctor:cli"
deus-witness-demo-tools = "deus_witness.demo_upstream:main"
deus-witness-hook = "deus_witness.hook.main:main"
deus-witness-verify-pack = "deus_witness.verify_pack.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["deus_witness"]

[tool.pytest.ini_options]
testpaths = ["tests"]
